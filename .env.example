# Neon (Postgres) — connection string desde Vercel > Storage > mate-app > .env.local tab
DATABASE_URL=postgresql://usuario:password@ep-xxx.neon.tech/mate-app?sslmode=require

# Auth.js — generado con: npx auth secret
AUTH_SECRET=

# Google OAuth (opcional, para login con Google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
